# LLM — OpenAI-compatible provider
# Moonshot example:
# MODEL_NAME=kimi-k2.6
# MODEL_API_KEY=your-api-key-here
# MODEL_BASE_URL=https://api.moonshot.cn/v1
# MODEL_THINKING=enabled
#
# SiliconFlow example:
MODEL_NAME=deepseek-ai/DeepSeek-V4-Pro
MODEL_API_KEY=your-api-key-here
MODEL_BASE_URL=https://api.siliconflow.cn/v1
MODEL_TEMPERATURE=0.7
MODEL_TIMEOUT=300
MODEL_THINKING=omit

# Futu OpenD live quotes (preferred over Sina). Requires OpenD logged in locally.
FUTU_ENABLED=1
FUTU_HOST=127.0.0.1
FUTU_PORT=11111
